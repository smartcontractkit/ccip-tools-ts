{
  "name": "@chainlink/ccip-sdk",
  "version": "1.16.1",
  "description": "SDK/Library to interact with CCIP",
  "author": "Chainlink devs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartcontractkit/ccip-tools-ts.git"
  },
  "homepage": "https://docs.chain.link/ccip/tools/sdk/",
  "bugs": {
    "url": "https://github.com/smartcontractkit/ccip-tools-ts/issues"
  },
  "type": "module",
  "sideEffects": [
    "./src/all-chains.ts",
    "./dist/all-chains.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./viem": {
      "types": "./dist/viem.d.ts",
      "default": "./dist/viem.js"
    },
    "./all": {
      "types": "./dist/all-chains.d.ts",
      "default": "./dist/all-chains.js"
    },
    "./cct/evm": {
      "types": "./dist/cct/evm/index.d.ts",
      "default": "./dist/cct/evm/index.js"
    },
    "./cct/solana": {
      "types": "./dist/cct/solana/index.d.ts",
      "default": "./dist/cct/solana/index.js"
    },
    "./cct/canton": {
      "types": "./dist/cct/canton/index.d.ts",
      "default": "./dist/cct/canton/index.js"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./src/canton/bindings/ccip-api-v2-2.0.0": "./src/canton/bindings/ccip-api-v2-2.0.0/index.js",
    "./src/canton/bindings/ccip-client-api-v2-2.0.0": "./src/canton/bindings/ccip-client-api-v2-2.0.0/index.js",
    "./src/canton/bindings/ccip-codec-v2-2.0.0": "./src/canton/bindings/ccip-codec-v2-2.0.0/index.js",
    "./src/canton/bindings/ccip-core-v2-2.1.1": "./src/canton/bindings/ccip-core-v2-2.1.1/index.js",
    "./src/canton/bindings/ccip-events-v2-2.0.0": "./src/canton/bindings/ccip-events-v2-2.0.0/index.js",
    "./src/canton/bindings/ccip-extension-api-v2-2.0.0": "./src/canton/bindings/ccip-extension-api-v2-2.0.0/index.js",
    "./src/canton/bindings/ccip-receiver-v2-2.1.0": "./src/canton/bindings/ccip-receiver-v2-2.1.0/index.js",
    "./src/canton/bindings/ccip-runtime-v2-2.1.1": "./src/canton/bindings/ccip-runtime-v2-2.1.1/index.js",
    "./src/canton/bindings/ccip-sender-v2-2.1.0": "./src/canton/bindings/ccip-sender-v2-2.1.0/index.js",
    "./src/canton/bindings/ccip-tickets-v2-2.0.0": "./src/canton/bindings/ccip-tickets-v2-2.0.0/index.js",
    "./src/canton/bindings/chainlink-api-2.0.0": "./src/canton/bindings/chainlink-api-2.0.0/index.js",
    "./src/canton/bindings/daml-prim-DA-Types-1.0.0": "./src/canton/bindings/daml-prim-DA-Types-1.0.0/index.js",
    "./src/canton/bindings/daml-stdlib-DA-Set-Types-1.0.0": "./src/canton/bindings/daml-stdlib-DA-Set-Types-1.0.0/index.js",
    "./src/canton/bindings/daml-stdlib-DA-Time-Types-1.0.0": "./src/canton/bindings/daml-stdlib-DA-Time-Types-1.0.0/index.js",
    "./src/canton/bindings/ghc-stdlib-DA-Internal-Template-1.0.0": "./src/canton/bindings/ghc-stdlib-DA-Internal-Template-1.0.0/index.js",
    "./src/canton/bindings/mcms-api-1.0.0": "./src/canton/bindings/mcms-api-1.0.0/index.js",
    "./src/canton/bindings/splice-api-token-burn-mint-v1-1.0.0": "./src/canton/bindings/splice-api-token-burn-mint-v1-1.0.0/index.js",
    "./src/canton/bindings/splice-api-token-holding-v1-1.0.0": "./src/canton/bindings/splice-api-token-holding-v1-1.0.0/index.js",
    "./src/canton/bindings/splice-api-token-metadata-v1-1.0.0": "./src/canton/bindings/splice-api-token-metadata-v1-1.0.0/index.js",
    "./src/canton/bindings/splice-api-token-transfer-instruction-v1-1.0.0": "./src/canton/bindings/splice-api-token-transfer-instruction-v1-1.0.0/index.js"
  },
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test \"src/**/!(*integration|*e2e|*fork).test.ts\"",
    "lint": "oxfmt --check ./src && oxlint ./src",
    "lint:fix": "oxfmt ./src && oxlint --fix ./src",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "build": "npm run clean && tsc -p ./tsconfig.build.json && cp -R ./src/canton/bindings ./dist/canton/bindings",
    "clean": "rm -rfv ./dist",
    "prepack": "node ../scripts/generate.cjs src/api/index.ts",
    "prepare": ""
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "!**/*.test.*",
    "!**/__tests__",
    "!**/__mocks__"
  ],
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "26.6.5",
    "esbuild": "^0.28.2",
    "ethers-abitype": "1.0.3",
    "prool": "^0.2.16",
    "protobufjs": "^8.8.0",
    "typescript": "7.0.2",
    "viem": "2.57.5"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "7.5.0",
    "@canton-network/dapp-sdk": "^1.8.0",
    "@coral-xyz/anchor": "^0.29.0",
    "@daml/types": "^3.6.2",
    "@metaplex-foundation/mpl-token-metadata": "3.4.0",
    "@metaplex-foundation/umi": "1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "1.6.0",
    "@metaplex-foundation/umi-web3js-adapters": "1.6.0",
    "@mojotech/json-type-validation": "^3.1.0",
    "@mysten/bcs": "2.1.2",
    "@mysten/sui": "2.36.0",
    "@noble/hashes": "^2.4.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@ton/core": "0.63.1",
    "@ton/ton": "^16.3.0",
    "abitype": "1.3.0",
    "axios": "1.20.0",
    "bn.js": "^5.2.5",
    "borsh": "^2.0.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "ethers": "6.17.0",
    "micro-memoize": "^5.2.0",
    "oauth4webapi": "^3.8.8",
    "openapi-fetch": "^0.17.0",
    "type-fest": "^5.10.0",
    "yaml": "2.9.1"
  }
}
