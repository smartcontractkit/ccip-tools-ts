{
  "name": "@chainlink/ccip-cli",
  "version": "1.14.0",
  "description": "CCIP Command Line Interface, based on @chainlink/ccip-sdk",
  "author": "Chainlink devs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartcontractkit/ccip-tools-ts.git"
  },
  "homepage": "https://docs.chain.link/ccip/tools/cli/",
  "bugs": {
    "url": "https://github.com/smartcontractkit/ccip-tools-ts/issues"
  },
  "type": "module",
  "bin": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test \"src/**/!(*integration|*e2e|*fork).test.ts\"",
    "lint": "oxfmt --check ./src && oxlint ./src",
    "lint:fix": "oxfmt ./src && oxlint --fix ./src",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "build": "npm run clean && tsc -p ./tsconfig.build.json && npm run patch-dist",
    "patch-dist": "chmod +x ./dist/index.js && find ./dist -type f -name \"*.js\" -exec sed -i.bkp 's|@chainlink/ccip-sdk/src/.*\\.ts|@chainlink/ccip-sdk|g' {} + && find ./dist -type f -name \"*.bkp\" -delete",
    "start": "./ccip-cli",
    "clean": "rm -rfv ./dist",
    "prepare": "npm run build"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "!**/*.test.*",
    "!**/__tests__",
    "!**/__mocks__"
  ],
  "devDependencies": {
    "@grpc/proto-loader": "^0.8.1",
    "@types/node": "26.6.2",
    "@types/update-notifier": "^6.0.8",
    "@types/yargs": "17.0.35",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^7.3.0",
    "@chainlink/ccip-sdk": "^1.14.0",
    "@coral-xyz/anchor": "^0.29.0",
    "@ethers-ext/signer-ledger": "^6.0.0-beta.1",
    "@grpc/grpc-js": "^1.14.5",
    "@inquirer/prompts": "8.7.2",
    "@ledgerhq/hw-transport": "6.36.0",
    "@ledgerhq/hw-app-aptos": "6.38.7",
    "@ledgerhq/hw-app-canton": "0.13.0",
    "@ledgerhq/hw-app-solana": "7.11.0",
    "@ledgerhq/hw-transport-node-hid": "6.33.5",
    "@mysten/sui": "^2.31.0",
    "@solana/web3.js": "^1.99.0",
    "@ton-community/ton-ledger": "^7.3.0",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "bip32-path": "^0.4.2",
    "bs58": "^6.0.0",
    "ethers": "6.17.0",
    "type-fest": "^5.10.0",
    "update-notifier": "^7.3.1",
    "yargs": "18.2.0"
  }
}
